{
  "rules": {
    "fragen": {
      ".read": true,
      "$id": {
        ".write": "auth != null && (root.child('ersteller').child(auth.uid).exists() || (!data.exists() && newData.exists() && newData.parent().parent().child('zuletzt').child(auth.uid).val() === now) || (data.exists() && !newData.exists() && root.child('autoren').child($id).val() === auth.uid))",
        ".validate": "newData.hasChildren(['text', 'erstellt', 'beantwortet', 'likes']) && (data.exists() || !newData.hasChild('beantwortetAm') || root.child('ersteller').child(auth.uid).exists())",
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 600 && (!data.exists() || newData.val() === data.val())"
        },
        "erstellt": {
          ".validate": "data.exists() ? newData.val() === data.val() : (newData.val() === now || (root.child('ersteller').child(auth.uid).exists() && newData.isNumber() && newData.val() <= now))"
        },
        "beantwortet": {
          ".validate": "newData.isBoolean() && (data.exists() || newData.val() === false || root.child('ersteller').child(auth.uid).exists())"
        },
        "beantwortetAm": {
          ".validate": "newData.val() === now || (root.child('ersteller').child(auth.uid).exists() && newData.isNumber() && newData.val() <= now)"
        },
        "likes": {
          ".write": "auth != null && data.exists() && ((newData.val() === data.val() + 1 && !root.child('likes').child(auth.uid).child($id).exists() && newData.parent().parent().parent().child('likes').child(auth.uid).child($id).exists()) || (newData.val() === data.val() - 1 && root.child('likes').child(auth.uid).child($id).exists() && !newData.parent().parent().parent().child('likes').child(auth.uid).child($id).exists()))",
          ".validate": "newData.isNumber() && newData.val() >= 0 && (data.exists() || newData.val() === 0 || root.child('ersteller').child(auth.uid).exists())"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "autoren": {
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && !root.child('fragen').child($id).exists() && newData.parent().parent().child('fragen').child($id).exists()) || (!newData.exists() && (data.val() === auth.uid || root.child('ersteller').child(auth.uid).exists())))",
        ".validate": "newData.isString()"
      }
    },
    "papierkorb": {
      ".read": "auth != null && root.child('ersteller').child(auth.uid).exists()",
      "$id": {
        ".write": "auth != null && root.child('ersteller').child(auth.uid).exists() && (newData.exists() || newData.parent().parent().child('fragen').child($id).exists())",
        ".validate": "newData.hasChildren(['text', 'erstellt', 'geloeschtAm'])",
        "geloeschtAm": {
          ".validate": "newData.val() === now"
        }
      }
    },
    "likes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$fid": {
          ".write": "auth != null && auth.uid === $uid && root.child('fragen').child($fid).exists() && (newData.exists() ? (!data.exists() && newData.parent().parent().parent().child('fragen').child($fid).child('likes').val() === root.child('fragen').child($fid).child('likes').val() + 1) : (data.exists() && newData.parent().parent().parent().child('fragen').child($fid).child('likes').val() === root.child('fragen').child($fid).child('likes').val() - 1))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "zuletzt": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now && (!data.exists() || now - data.val() >= 5000)"
      }
    },
    "ersteller": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('ersteller').child(auth.uid).exists()",
        ".validate": "newData.isString() || newData.isBoolean()"
      }
    },
    "anfragen": {
      ".read": "auth != null && root.child('ersteller').child(auth.uid).exists()",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && auth.token.firebase.sign_in_provider === 'google.com' && !root.child('gesperrt').child($uid).exists()) || (root.child('ersteller').child(auth.uid).exists() && !newData.exists()))",
        ".validate": "newData.hasChildren(['email', 'zeit'])",
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "zeit": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "gesperrt": {
      ".read": "auth != null && root.child('ersteller').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('ersteller').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['email', 'zeit'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 320"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "zeit": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
